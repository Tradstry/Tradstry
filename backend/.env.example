# Tradstry Backend Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# Database — Postgres (all app data: trading tables, chat sessions,
# LangGraph checkpoints + memory store, and pgvector embeddings).
POSTGRES_URL=postgres://user:pass@localhost:5432/your-name

# Environment schema selector. The app namespaces ALL its tables under a
# per-environment Postgres schema so environments never collide in one database:
#   dev  -> schema tradstry_dev
#   prod -> schema tradstry_prod
# Leave unset to use the default `public` schema.
POSTGRES_DATABASE=dev

# Auth — Clerk
CLERK_SECRET_KEY=sk_live_...

# Market data — Polygon.io. Enables Polygon snapshot quotes and the live
# per-second aggregate WebSocket used by the desktop menu-bar ticker.
POLYGON_API_KEY=

# Fundamentals — Financial Modeling Prep. Used for earnings call transcripts.
FMP_API_KEY=

# AI Provider - Gemini (the model itself is pinned in code)
GEMINI_API_KEY=AIk....
GEMINI_PREAMBLE=

# Embeddings + Reranking — Voyage. Only the key is required; the rest fall back
# to the defaults shown here.
VOYAGE_API_KEY=pa-...
VOYAGE_EMBEDDING_MODEL=voyage-3.5
VOYAGE_RERANKER_MODEL=rerank-2.5
VOYAGE_OUTPUT_DIMENSION=2048
VOYAGE_RPM=2000
VOYAGE_TPM=8000000

# Media — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Brokerage — SnapTrade (via Go microservice)
SNAPTRADE_SERVICE_URL=http://localhost:9086
BROKERAGE_ENCRYPTION_KEY=
# true runs one sync of every connected account at boot, off-schedule.
SYNC_TEST_NOW=false

# Cache — optional. Unset or unreachable, the server logs a warning and runs
# without a cache.
REDIS_URL=redis://localhost:6379

# Product analytics — Countly Lite. The app key and host are both required;
# analytics stays disabled when either is omitted.
COUNTLY_APP_KEY=
COUNTLY_HOST=https://countly.example.com

# Server
# Dependencies are noisy at info — sqlx logs every statement, which buries
# everything else in query text.
RUST_LOG=info,sqlx=warn,hyper=warn,h2=warn,rustls=warn
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Observability
LOG_FORMAT=pretty
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Web push (VAPID). Generate a key pair once and keep the private key secret.
# Unset, the delivery worker does not start and notifications stay in the feed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tradstry.com

# MCP server only (the mcp-server binary; the API server ignores these).
MCP_PUBLIC_URL=http://localhost:7900
CLERK_ISSUER=https://your-app.clerk.accounts.dev
MCP_BIND_ADDR=0.0.0.0:7900

# Integration tests only. Unset, they use
# postgres://tradstry:tradstry@localhost:5435/tradstry_test
TEST_DATABASE_URL=
