# syntax=docker/dockerfile:1
#
# Shared builder → two runtime targets. `chef`/`planner`/`builder` are shared,
# so workspace dependencies and both binaries compile ONCE; the `backend` and
# `mcp` runtime stages are thin images off that builder. Build with
# `--target backend` or `--target mcp`.

FROM rust:1.95-bookworm AS chef
RUN cargo install cargo-chef --locked
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates ./crates
COPY mcp-server ./mcp-server
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates ./crates
COPY mcp-server ./mcp-server
COPY migrations ./migrations
RUN cargo build --release -p tradstry-backend --bin tradstry-backend -p mcp-server --bin mcp-server

# The Yjs -> Lexical JSON projection can only run in JavaScript: the mapping lives in
# Lexical's node classes. bun is the repo's only JS runtime, for install and for run.
FROM oven/bun:1.3.13-slim AS projector-deps
WORKDIR /projector
COPY projector/package.json projector/bun.lock ./
RUN bun install --frozen-lockfile --production
# Sources only — a bare `COPY projector/ ./` would overwrite the freshly installed
# node_modules with the host's.
COPY projector/*.mjs ./
# The shared schema arrives via a named build context (compose: additional_contexts),
# because packages/ lives outside this stage's `context: backend`.
COPY --from=notebook-core . /core
# Built INTO /projector so its bare @lexical/* imports resolve from the projector's
# node_modules. A second Lexical copy would break class identity.
RUN bun build /core/src/index.ts --target=bun --format=esm \
      --outfile notebook-core.gen.mjs --external lexical --external '@lexical/*'

FROM debian:bookworm-slim AS backend
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg && rm -rf /var/lib/apt/lists/*
# bun is the only JS runtime in this repo. Pinned: 1.3.14 regressed on Lexical's
# circular ESM ("Cannot access 'ElementNode' before initialization").
COPY --from=oven/bun:1.3.13-slim /usr/local/bin/bun /usr/local/bin/bun
RUN useradd --create-home appuser
USER appuser
WORKDIR /home/appuser
COPY --from=builder /app/target/release/tradstry-backend .
# projector/ must sit beside the binary: projector_dir() resolves relative to current_exe().
COPY --from=projector-deps --chown=appuser:appuser /projector ./projector

ENV RUST_LOG=info
ENV RUST_BACKTRACE=1
EXPOSE 7899
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -sf http://localhost:7899/ || test $? -eq 22
CMD ["./tradstry-backend"]

FROM debian:bookworm-slim AS mcp
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home appuser
USER appuser
WORKDIR /home/appuser
COPY --from=builder /app/target/release/mcp-server .
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1
EXPOSE 7900
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -sf http://localhost:7900/health || exit 1
CMD ["./mcp-server"]
