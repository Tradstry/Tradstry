# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage/
**/playwright-report/
**/test-results/
.vitest-*

# framework and build outputs
**/.next/
**/dist/
**/dist-ssr/
**/out/
**/release/
**/.cache/
**/.turbo/
**/.vite/

# production
**/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (examples and templates stay committable)
.env*
devops/deploy.env*
.deploy.lock
.current-deploy-commit
.previous-deploy-commit
!.env.example
!.env.template

# vercel
.vercel

# Website-local tooling and secrets
/apps/website/.pnp
/apps/website/.yarn/*
!/apps/website/.yarn/patches
!/apps/website/.yarn/plugins
!/apps/website/.yarn/releases
!/apps/website/.yarn/versions
/apps/website/.clerk/
/apps/website/.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local helper scripts (not needed in repo)
*.local.sh

