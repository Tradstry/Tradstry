/apps/desktop/**/logs
/apps/desktop/**/*.log
/apps/desktop/**/pnpm-debug.log*
/apps/desktop/**/lerna-debug.log*
/apps/desktop/**/*.local
/apps/desktop/**/.idea
/apps/desktop/**/*.suo
