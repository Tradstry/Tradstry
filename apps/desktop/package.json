{
  "name": "@tradstry/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --dir",
    "build:renderer": "electron-vite build",
    "preview": "electron-vite preview",
    "test:main": "node --test electron/sync/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@internationalized/date": "^3.12.2",
    "@lexical/code": "0.46.0",
    "@lexical/code-prism": "0.46.0",
    "@lexical/headless": "0.46.0",
    "@lexical/link": "0.46.0",
    "@lexical/list": "0.46.0",
    "@lexical/markdown": "0.46.0",
    "@lexical/react": "0.46.0",
    "@lexical/rich-text": "0.46.0",
    "@lexical/selection": "0.46.0",
    "@lexical/table": "0.46.0",
    "@lexical/utils": "0.46.0",
    "@lexical/yjs": "0.46.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@tradstry/notebook-core": "workspace:*",
    "@tradstry/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lexical": "0.46.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "recharts": "3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.user.tradstry",
    "productName": "Tradstry",
    "directories": {
      "output": "release"
    },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      {
        "from": "electron/sync/schema.sql",
        "to": "schema.sql"
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.finance"
    },
    "win": {
      "icon": "resources/icons/icon.ico"
    },
    "linux": {
      "icon": "resources/icons/icon.png",
      "category": "Office"
    }
  },
  "trustedDependencies": ["electron", "electron-winstaller", "esbuild"]
}
