{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "electron"],
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "electron.vite.config.ts"]
}
