# Bugsink — self-hosted, Sentry-SDK-compatible error tracking.
#
# Copy to .env.production and fill in. deploy.sh ships that file to the server
# as bugsink/.env, which docker-compose.yml loads via env_file.
#
# Only secrets belong here. Everything non-sensitive (PORT, DATABASE_PATH,
# BASE_URL, BEHIND_HTTPS_PROXY) lives in docker-compose.yml, which is tracked.

# Django secret key — must be at least 50 characters. Generate one with:
#   openssl rand -base64 50 | tr -d '\n' | tr '+/' '-_'
SECRET_KEY=

# Initial admin, as email:password. Applied on first boot only and inert
# afterwards, so change the password in the UI once you're in — editing this
# later has no effect on an existing install.
CREATE_SUPERUSER=you@example.com:changeme
