{
  "name": "tradstry-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "bun run --cwd apps/website dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build:website": "bun run --cwd apps/website build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "typecheck:app-ui": "bunx tsc --noEmit -p packages/app-ui/tsconfig.json",
    "test:packages": "bunx bun@1.3.13 test packages/app-ui packages/notebook-core && bun run --cwd apps/desktop test:main"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "undici": "7.29.0"
  },
  "packageManager": "bun@1.3.13"
}
