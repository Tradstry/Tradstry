{
  "name": "tradstry-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "bun run --cwd apps/website dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build:website": "bun run --cwd apps/website build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "test:packages": "bunx bun@1.3.13 test packages/notebook-core && bun run --cwd apps/desktop test:main"
  },
  "packageManager": "bun@1.3.13"
}
